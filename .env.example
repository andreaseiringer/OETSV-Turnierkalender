# pivitLABS ÖTSV Tool – Konfiguration (https://pivitlabs.com)
APP_ENV=production
APP_VERSION=1.4.0
HOST=127.0.0.1
PORT=8000
TIMEZONE=Europe/Vienna

# Sicherheit (Optionales Passwort für /adsi-admin im LAN-Betrieb)
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Verein einstellen (Club-Konfiguration)
CLUB_NAME=TSC Musterverein
CLUB_SHORT=Musterverein
CLUB_KEYWORDS=tsc,musterverein

# Datenbank & Pfade
DATABASE_PATH=data/adsi.db
LOG_DIR=logs

# ÖTSV Web Scraper
SCRAPER_CALENDAR_URL=https://www.tanzsportverband.at/kalender/daten.html
SCRAPER_MONTHS_AHEAD=12
SCRAPER_CRON_HOUR=4
SCRAPER_CRON_MINUTE=0
SCRAPER_RATE_LIMIT_DELAY=0.5

# IMAP E-Mail Fetcher
IMAP_ENABLED=false
IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USER=turniere@example.com
IMAP_PASSWORD=secret
IMAP_MAILBOX=INBOX
IMAP_FETCH_INTERVAL_MINUTES=15
IMAP_ALLOWED_SENDERS=noreply@tanzsportverband.at,office@tanzsportverband.at,nennungen@tanzsportverband.at,nennungen@oetsv.at,office@oetsv.at,oetsv.at
# Mock-Modus für lokale Tests ohne echtes Postfach (true/false)
IMAP_MOCK=false
